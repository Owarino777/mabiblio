---
export interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Accessible UI Kit - Web components built for accessibility, eco-design, and privacy.',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Eco-design: No external fonts, use system fonts -->
    <!-- GDPR: No third-party resources -->
    <!-- Security: CSP-friendly, no inline scripts -->

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Preload critical CSS -->
    <link rel="stylesheet" href="/styles/tokens.css" />
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <header class="site-header">
      <nav aria-label="Main navigation">
        <a href="/" class="logo">Accessible UI Kit</a>
        <ul class="nav-list" role="list">
          <li><a href="/getting-started">Getting Started</a></li>
          <li><a href="/components">Components</a></li>
          <li><a href="/accessibility">Accessibility</a></li>
          <li><a href="/eco-design">Eco-Design</a></li>
        </ul>
        <button type="button" class="theme-toggle" aria-label="Toggle dark mode" data-theme-toggle>
          <span class="theme-toggle-icon" aria-hidden="true">🌙</span>
        </button>
      </nav>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="footer-content">
        <p>&copy; 2026 Accessible UI Kit. MIT License.</p>
        <nav aria-label="Footer navigation">
          <ul role="list">
            <li><a href="/privacy">Privacy</a></li>
            <li><a href="/legal">Legal</a></li>
            <li><a href="https://github.com/your-org/accessible-ui-kit">GitHub</a></li>
          </ul>
        </nav>
      </div>
    </footer>

    <!-- Minimal JS for theme toggle only -->
    <script>
      // Theme toggle functionality
      const themeToggle = document.querySelector('[data-theme-toggle]');
      const html = document.documentElement;

      // Check for saved preference or system preference
      function getPreferredTheme() {
        const saved = localStorage.getItem('theme');
        if (saved) return saved;
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }

      // Apply theme
      function setTheme(theme) {
        html.setAttribute('data-theme', theme);
        localStorage.setItem('theme', theme);
        const icon = themeToggle?.querySelector('.theme-toggle-icon');
        if (icon) {
          icon.textContent = theme === 'dark' ? '☀️' : '🌙';
        }
      }

      // Initialize
      setTheme(getPreferredTheme());

      // Toggle handler
      themeToggle?.addEventListener('click', () => {
        const current = html.getAttribute('data-theme');
        setTheme(current === 'dark' ? 'light' : 'dark');
      });

      // Listen for system changes
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        if (!localStorage.getItem('theme')) {
          setTheme(e.matches ? 'dark' : 'light');
        }
      });
    </script>
  </body>
</html>

<style is:global>
  /* Skip link for keyboard navigation */
  .skip-link {
    position: absolute;
    top: -100%;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-primary);
    color: var(--color-on-primary);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-md);
    z-index: var(--z-modal);
    text-decoration: none;
    font-weight: var(--font-weight-medium);
  }

  .skip-link:focus {
    top: var(--space-sm);
  }

  /* Visually hidden but accessible */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background: var(--color-background);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1400px;
    margin: 0 auto;
    padding: var(--space-md) var(--space-lg);
    gap: var(--space-lg);
  }

  .logo {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .logo:hover,
  .logo:focus {
    color: var(--color-primary);
  }

  .nav-list {
    display: flex;
    gap: var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-list a {
    color: var(--color-text-secondary);
    text-decoration: none;
    font-weight: var(--font-weight-medium);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
  }

  .nav-list a:hover,
  .nav-list a:focus {
    color: var(--color-text-primary);
    background: var(--color-surface-hover);
  }

  .theme-toggle {
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-xs) var(--space-sm);
    cursor: pointer;
    font-size: var(--font-size-lg);
    line-height: 1;
  }

  .theme-toggle:hover,
  .theme-toggle:focus {
    background: var(--color-surface-hover);
    border-color: var(--color-border-hover);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .footer-content {
    max-width: 1400px;
    margin: 0 auto;
    padding: var(--space-lg);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .footer-content p {
    margin: 0;
    color: var(--color-text-secondary);
  }

  .footer-content ul {
    display: flex;
    gap: var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-content a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .footer-content a:hover,
  .footer-content a:focus {
    color: var(--color-text-primary);
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .nav-list {
      display: none; /* TODO: Add mobile menu */
    }
  }
</style>
